import { Theme } from "theme.slint";

export component Cover inherits Rectangle {
    in property <color> color-a: #1d4ed8;
    in property <color> color-b: #9be15d;
    in property <string> glyph: "♪";
    in property <length> glyph-size: 48px;
    in property <length> radius: Theme.radius-lg;
    in property <bool> glow: false;
    in property <bool> highlight: false;

    border-width: root.highlight ? 2px : 0px;
    border-color: #1463ff99;
    animate border-width { duration: 160ms; easing: ease-out; }
    background: @linear-gradient(135deg, color-a 0%, color-b 100%);
    border-radius: root.radius;
    clip: true;

    // Ambient print/texture, like the physical CD sleeves in the desktop app.
    Rectangle {
        x: parent.width * 0.58;
        y: -parent.height * 0.24;
        width: parent.width * 0.8;
        height: parent.height * 0.8;
        border-radius: self.width / 2;
        background: #ffffff22;
    }
    Rectangle {
        x: -parent.width * 0.2;
        y: parent.height * 0.56;
        width: parent.width * 0.72;
        height: parent.height * 0.38;
        border-radius: self.width / 2;
        background: #ffffff12;
    }
    Text {
        text: root.glyph;
        color: #ffffffd9;
        font-size: root.glyph-size;
        font-weight: 300;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    if root.glow: Rectangle {
        border-radius: root.radius;
        border-width: 1px;
        border-color: #ffffff66;
    }
}

export component Equalizer inherits HorizontalLayout {
    in property <int> tick: 0;
    in property <color> color: Theme.accent;
    in property <length> bar-width: 3px;
    spacing: 3px;
    height: 18px;

    for i in 5: Rectangle {
        width: root.bar-width;
        border-radius: 2px;
        background: root.color;
        height: (5px + (Math.mod(root.tick + i * 4, 15) * 1px));
        animate height { duration: 120ms; easing: ease-out; }
    }
}

export component PlayPulse inherits Rectangle {
    in property <bool> playing: false;
    in property <int> tick: 0;
    callback clicked;
    width: 52px;
    height: 52px;
    border-radius: 26px;
    background: Theme.accent;
    drop-shadow-color: #1463ff40;
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 8px;
    animate width { duration: 180ms; easing: ease-out; }
    animate height { duration: 180ms; easing: ease-out; }

    // A slow breathing ring, driven from the window's shared tick.
    if root.playing: Rectangle {
        x: -4px - (Math.mod(root.tick, 24) * 0.16px);
        y: -4px - (Math.mod(root.tick, 24) * 0.16px);
        width: parent.width + 8px + (Math.mod(root.tick, 24) * 0.32px);
        height: parent.height + 8px + (Math.mod(root.tick, 24) * 0.32px);
        border-radius: self.width / 2;
        border-width: 1px;
        border-color: #1463ff24;
    }
    Text {
        text: root.playing ? "❚❚" : "▶";
        color: #ffffff;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component RoundButton inherits Rectangle {
    property <bool> hovered: touch.has-hover;
    in property <string> glyph;
    in property <bool> primary: false;
    callback clicked;
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: root.primary ? Theme.accent : (root.hovered ? Theme.accent-soft : transparent);
    border-width: 1px;
    border-color: root.primary ? transparent : Theme.border;
    animate background { duration: 140ms; }
    animate border-color { duration: 140ms; }
    Text {
        text: root.glyph;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavItem inherits Rectangle {
    property <bool> hovered: touch.has-hover;
    in property <string> label;
    in property <string> glyph;
    in property <bool> selected: false;
    callback clicked;
    height: 48px;
    border-radius: 12px;
    background: root.selected ? Theme.accent : (root.hovered ? Theme.surface-soft : transparent);
    animate background { duration: 180ms; }
    Text {
        x: 14px;
        text: root.glyph;
        color: root.selected ? #ffffff : Theme.text-weak;
        font-size: 17px;
        vertical-alignment: center;
        height: 100%;
    }
    Text {
        x: 48px;
        text: root.label;
        color: root.selected ? #ffffff : Theme.text;
        font-size: 14px;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        height: 100%;
    }
    if root.selected: Rectangle {
        x: 0px;
        y: 12px;
        width: 3px;
        height: 24px;
        border-radius: 2px;
        background: Theme.lime;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component SoftButton inherits Rectangle {
    property <bool> hovered: touch.has-hover;
    in property <string> label;
    in property <bool> primary: false;
    callback clicked;
    height: 38px;
    width: max(108px, label-text.preferred-width + 30px);
    border-radius: 12px;
    background: root.primary ? Theme.accent : (root.hovered ? Theme.accent-soft : Theme.surface);
    border-width: 1px;
    border-color: root.primary ? transparent : Theme.border;
    animate background { duration: 150ms; }
    label-text := Text {
        text: root.label;
        color: root.primary ? #ffffff : Theme.text;
        font-size: 12px;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GlassCard inherits Rectangle {
    background: #ffffffb8;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: Theme.radius-lg;
    clip: true;
}

export component AlbumCard inherits Rectangle {
    property <bool> hovered: touch.has-hover;
    in property <int> tick: 0;
    in property <color> color-a;
    in property <color> color-b;
    in property <string> glyph;
    in property <string> title;
    in property <string> artist;
    in property <bool> current: false;
    callback clicked;

    background: transparent;
    height: 252px;
    property <length> lift: root.hovered ? -7px : 0px;
    animate lift { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        spacing: 10px;
        content := Cover {
            width: 100%;
            height: 180px;
            color-a: root.color-a;
            color-b: root.color-b;
            glyph: root.glyph;
            glyph-size: 54px;
            radius: 20px;
            highlight: root.hovered;
            if root.current: Rectangle {
                x: 12px;
                y: 12px;
                width: 28px;
                height: 22px;
                border-radius: 11px;
                background: #ffffffcc;
                Equalizer {
                    x: 7px;
                    y: 5px;
                    tick: root.tick;
                    color: Theme.accent;
                    bar-width: 2px;
                }
            }
        }
        Text {
            text: root.title;
            color: root.current ? Theme.accent : Theme.text;
            font-size: 14px;
            font-weight: 600;
            overflow: elide;
            width: 100%;
        }
        Text {
            text: root.artist;
            color: Theme.text-weak;
            font-size: 12px;
            overflow: elide;
            width: 100%;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
