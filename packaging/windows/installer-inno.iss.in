; EchoPort Windows installer (Inno Setup 6+), generated by scripts/package-inno.sh.
; Per-user install (no admin). Built/compiled in CI or with Wine locally.
#define MyAppName "EchoPort"
#define MyAppVersion "@VERSION@"
#define MyAppPublisher "nilotoo"
#define MyAppURL "https://github.com/Nilotoo/EchoPort"
#define MyAppExeName "echoport.exe"
#define MyStage "@STAGE@"

[Setup]
AppId={{6F1C4C5A-1C1C-5DC1-9D0C-ECHPORT00001}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}/releases
DefaultDirName={localappdata}\Programs\EchoPort
DefaultGroupName=EchoPort
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir=@OUTDIR@
OutputBaseFilename=echoport-{#MyAppVersion}-windows-x86_64-inno-setup
SetupIconFile=@ICON@
UninstallDisplayIcon={app}\echoport.ico
LicenseFile=@LICENSE@
Compression=lzma2/ultra64
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
SetupLogging=yes
ChangesAssociations=no
InfoBeforeFile=@INFOFILE@

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinesesimplified"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; GroupDescription: "Additional shortcuts:"; Flags: unchecked

[Files]
Source: "{#MyStage}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{group}\EchoPort"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\echoport.ico"; WorkingDir: "{app}"
Name: "{group}\Uninstall EchoPort (clean app data)"; Filename: "{app}\clean-uninstall.cmd"; IconFilename: "{app}\echoport.ico"
Name: "{group}\{cm:UninstallProgram,EchoPort}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\EchoPort"; Filename: "{app}\{#MyAppExeName}"; IconFilename: "{app}\echoport.ico"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "Launch EchoPort"; Flags: nowait postinstall skipifsilent

[Code]
procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if CurUninstallStep = usPostUninstall then
  begin
    if MsgBox('Also remove EchoPort settings, profiles and caches?' + #13#10 +
              'Downloaded music in your Music folder is kept.', mbConfirmation, MB_YESNO) = IDYES then
    begin
      DelTree(ExpandConstant('{userappdata}\echoport'), True, True, True);
      DelTree(ExpandConstant('{localappdata}\echoport'), True, True, True);
    end;
  end;
end;
