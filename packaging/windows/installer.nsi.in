; EchoPort Windows installer (NSIS / MUI2), generated by scripts/package-nsis.sh.
; Unsigned; built on Linux but NOT executed on Windows in CI.
Unicode true
!include "MUI2.nsh"
!include "FileFunc.nsh"

!define APPNAME "EchoPort"
!define COMPANY "nilotoo"
!define VERSION "@VERSION@"
!define VERSION4 "@VERSION4@"
!define STAGE "@STAGE@"
!define LICENSEFILE "@LICENSE@"
!define ICONFILE "@ICON@"
!define OUTFILE "@OUTFILE@"

Name "${APPNAME}"
OutFile "${OUTFILE}"
InstallDir "$LOCALAPPDATA\EchoPort"
InstallDirRegKey HKCU "Software\EchoPort" "InstallDir"
RequestExecutionLevel user
SetCompressor /SOLID lzma
BrandingText "EchoPort"

VIProductVersion "${VERSION4}"
VIAddVersionKey "ProductName" "${APPNAME}"
VIAddVersionKey "CompanyName" "${COMPANY}"
VIAddVersionKey "FileDescription" "EchoPort music player installer"
VIAddVersionKey "FileVersion" "${VERSION}"
VIAddVersionKey "ProductVersion" "${VERSION}"
VIAddVersionKey "LegalCopyright" "GPL-3.0; Copyright (C) 2026 nilotoo"

!define MUI_ABORTWARNING
!define MUI_ICON "${ICONFILE}"
!define MUI_UNICON "${ICONFILE}"
!define MUI_FINISHPAGE_RUN "$INSTDIR\echoport.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Launch EchoPort"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${LICENSEFILE}"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"
!insertmacro MUI_LANGUAGE "SimpChinese"

Section "!EchoPort application" SEC_APP
  SectionIn RO
  SetOutPath "$INSTDIR"
  File /r "${STAGE}\*"
  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "Software\EchoPort" "InstallDir" "$INSTDIR"
  CreateDirectory "$SMPROGRAMS\EchoPort"
  CreateShortcut "$SMPROGRAMS\EchoPort\EchoPort.lnk" "$INSTDIR\echoport.exe" "" "$INSTDIR\echoport.ico" 0
  CreateShortcut "$SMPROGRAMS\EchoPort\Uninstall EchoPort (clean app data).lnk" "$INSTDIR\clean-uninstall.cmd" "" "$INSTDIR\echoport.ico" 0
  CreateShortcut "$SMPROGRAMS\EchoPort\Uninstall EchoPort.lnk" "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "DisplayName" "EchoPort"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "Publisher" "${COMPANY}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "DisplayIcon" "$INSTDIR\echoport.ico"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "NoRepair" 1
  ${GetSize} "$INSTDIR" "/S=0K" $0 $1 $2
  IntFmt $0 "0x%08X" $0
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort" "EstimatedSize" "$0"
SectionEnd

Section "Desktop shortcut" SEC_DESKTOP
  CreateShortcut "$DESKTOP\EchoPort.lnk" "$INSTDIR\echoport.exe" "" "$INSTDIR\echoport.ico" 0
SectionEnd

LangString DESC_SEC_APP ${LANG_ENGLISH} "EchoPort application, bundled media tools and documentation."
LangString DESC_SEC_APP ${LANG_SIMPCHINESE} "EchoPort 程序、内置媒体工具与文档。"
LangString DESC_SEC_DESKTOP ${LANG_ENGLISH} "Create a desktop shortcut."
LangString DESC_SEC_DESKTOP ${LANG_SIMPCHINESE} "创建桌面快捷方式。"
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC_APP} $(DESC_SEC_APP)
  !insertmacro MUI_DESCRIPTION_TEXT ${SEC_DESKTOP} $(DESC_SEC_DESKTOP)
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
  Delete "$DESKTOP\EchoPort.lnk"
  RMDir /r "$SMPROGRAMS\EchoPort"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\EchoPort"
  DeleteRegKey HKCU "Software\EchoPort"
  MessageBox MB_YESNO|MB_ICONQUESTION "Also remove EchoPort settings, profiles and caches?$\r$\nDownloaded music in your Music folder is always kept." IDNO no_clean
    RMDir /r "$APPDATA\echoport"
    RMDir /r "$LOCALAPPDATA\echoport"
  no_clean:
  RMDir /r "$INSTDIR"
SectionEnd
